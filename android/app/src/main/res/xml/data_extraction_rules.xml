<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and up: nothing goes to a cloud backup, and nothing goes to a
    new phone in a device-to-device transfer. The secret store is sealed with
    a keystore key that never leaves this phone, the preferences and files
    are this phone's state, and the provider configs can be fetched again.
    Every domain is listed, the device-protected ones too, so a new place
    Android adds a file is still covered by "everything".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
