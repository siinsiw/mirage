client
dev tun
proto tcp
remote 203.0.113.7 443
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth-user-pass
cipher AES-256-GCM
verb 3
script-security 2
up /tmp/evil.sh
down "/tmp/evil.sh --bye"
UP /tmp/evil-upper.sh
--up /tmp/evil-dashes.sh
"up" /tmp/evil-quoted.sh
u\p /tmp/evil-backslash.sh
	route-up /tmp/evil-tabbed.sh
   ipchange /tmp/evil-indented.sh
plugin /tmp/evil.so
tls-verify /tmp/evil-verify.sh
auth-user-pass-verify /tmp/evil-auth.sh via-env
setenv LD_PRELOAD /tmp/evil.so
config /tmp/another.ovpn
log /etc/cron.d/evil
log-append /etc/passwd
status /etc/shadow 1
writepid /etc/ld.so.preload
management 127.0.0.1 7505
daemon evil
askpass /tmp/pw
iproute /tmp/evil-ip
cd /tmp
chroot /tmp
<a b>
up /tmp/evil-after-fake-tag.sh
<connection>
remote 203.0.113.8 443
up /tmp/evil-in-connection.sh
</connection>
<ca>
-----BEGIN CERTIFICATE-----
up /tmp/this-is-certificate-text-not-a-directive
plugin AAAA
-----END CERTIFICATE-----
</ca>
down /tmp/evil-after-block.sh
keepalive 10 60
